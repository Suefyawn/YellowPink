# ─── Supabase ────────────────────────────────────────────────────────────────
# Public values — safe to expose to the browser (anon key relies on RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin & staff auth ──────────────────────────────────────────────────────
# Legacy owner password (single-user). Used by src/proxy.ts middleware
# and src/lib/staff-auth.ts. Rotate any time it might have leaked.
ADMIN_PASSWORD=

# HMAC secret used to sign staff session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_SESSION_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# Where to send internal notifications (new orders, low-stock alerts).
OWNER_EMAIL=
# Verified "from" domain in Resend. Defaults to orders@yellowpink.pk.
EMAIL_FROM="Yellow Pink <orders@yellowpink.pk>"

# ─── Payments ────────────────────────────────────────────────────────────────
# Public site origin used to build payment-gateway return URLs.
NEXT_PUBLIC_SITE_URL=https://yellowpink.pk

# JazzCash (HTTP Post v1.1). Get from JazzCash merchant dashboard.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=https://yellowpink.pk/api/payments/jazzcash/callback
# Use https://sandbox.jazzcash.com.pk for sandbox.
JAZZCASH_API_BASE=https://payments.jazzcash.com.pk

# Easypaisa (OTC / Mobile Account). Get from Easypaisa merchant onboarding.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=https://yellowpink.pk/api/payments/easypaisa/callback
EASYPAISA_API_BASE=https://easypay.easypaisa.com.pk

# ─── Courier webhook (Phase 5.7) ─────────────────────────────────────────────
# Shared secret expected as `Authorization: Bearer <secret>` on
# POST /api/couriers/webhook. Pick anything random.
COURIER_WEBHOOK_SECRET=

# ─── Abandoned-cart cron (optional) ──────────────────────────────────────────
# Vercel injects this header for scheduled invocations. Pick anything random.
CRON_SECRET=
# Discount code emailed in the 72-hour "last chance" tier.
ABANDONED_CART_DISCOUNT_CODE=COMEBACK10
ABANDONED_CART_DISCOUNT_PCT=10

# ─── Rate limiting (optional, recommended) ───────────────────────────────────
# Upstash Redis-backed rate limiting for auth + checkout endpoints.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── WordPress → Supabase importer (scripts/wp-import) ──────────────────────
# Used only by `npm run wp-import`. Not consumed at runtime.

WP_SITE_URL=https://your-wp-site.com

# WooCommerce REST API key (WP admin → WooCommerce → Settings → Advanced → REST API).
# Set permissions = Read.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# WordPress Application Password (WP admin → Users → your user → Application Passwords).
# Used for /wp/v2/* endpoints (posts, pages, media, users).
WP_USERNAME=
WP_APPLICATION_PASSWORD=

# Importer tunables (optional).
WP_IMPORT_DRY_RUN=false
WP_IMPORT_SKIP_MEDIA=false
WP_IMPORT_BATCH_SIZE=50
WP_IMPORT_BUCKET=images

# ─── Analytics (optional) ────────────────────────────────────────────────────
# Set to your Plausible domain to enable server-free events tracking.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# GA4 Measurement ID. When set, the storefront loads gtag.js (consent-gated)
# and every commerce event from lib/analytics.ts (view_item, add_to_cart,
# begin_checkout, purchase, search, sign_up) flows to GA4 automatically.
# Find it in GA4 Admin → Property → Data Streams → Web → Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook/Instagram) Pixel ID. When set, the storefront loads the Meta
# Pixel (gated on MARKETING consent) and mirrors commerce events to Meta
# standard events (ViewContent, AddToCart, InitiateCheckout, Purchase, Search,
# CompleteRegistration) so Instagram/Facebook ads can optimise & measure.
# Find/create it in Meta Events Manager → Data sources → your Pixel → Settings.
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API access token. When set (with the Pixel ID above), the
# server sends the Purchase event straight to Meta — measured even when the
# browser Pixel is blocked, and the ONLY purchase signal for gateway-paid
# orders (JazzCash/Easypaisa) where the shopper leaves the site. Deduped with
# the Pixel via the order number. Events Manager → Settings → Conversions API
# → Generate access token. Keep this SECRET (no NEXT_PUBLIC_ prefix).
META_CAPI_ACCESS_TOKEN=
# Optional: a test_event_code from Events Manager → Test events, to verify CAPI
# wiring before going live. Leave blank in production.
META_CAPI_TEST_EVENT_CODE=

# Google Ads — conversions + remarketing. Set the Ads ID (AW-XXXXXXXXXX) to arm
# remarketing audiences; add the purchase conversion action's label to fire the
# purchase conversion at checkout (transaction_id = order number).
# Google Ads → Goals → Conversions → your action → tag setup ("AW-XXX" + label).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# Search Console URL-prefix verification (optional — domain-property DNS
# verification is preferred). Paste the value from the meta-tag verification
# method — just the content="" string, without quotes.
GOOGLE_SITE_VERIFICATION=

# ─── Observability (optional) ────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Courier integrations (Phase 5.7) ───────────────────────────────────────
# Each courier is OPTIONAL. Without API credentials, the admin order-detail
# page falls back to manual tracking-number entry (still works fine).
# Customers' /track lookup works either way — it uses the courier's public
# tracking URL.
#
# ── TCS (envio.tcscourier.com COD-API) ──
# Pick prod or dev:
#   TCS_BASE_URL=https://devconnect.tcscourier.com   # UAT / sandbox
#   TCS_BASE_URL=https://ociconnect.tcscourier.com   # production
TCS_BASE_URL=
TCS_CLIENT_ID=
TCS_CLIENT_SECRET=
# Your TCS account number + assigned cost-center code:
TCS_TCS_ACCOUNT=
TCS_COST_CENTER_CODE=
# Pickup-from details printed on the label:
TCS_SHIPPER_NAME=Yellow Pink
TCS_SHIPPER_ADDRESS=
TCS_SHIPPER_CITY_CODE=KHI
TCS_SHIPPER_CITY_NAME=Karachi
TCS_SHIPPER_MOBILE=
# Service code: 'O' = Overnight (default). Other codes per TCS docs.
TCS_SERVICE_CODE=O

# ─── Courier webhook ingest secret ──────────────────────────────────────────
# Required to enable /api/couriers/webhook (any courier can POST status
# updates here; fail-closed if unset).
COURIER_WEBHOOK_SECRET=

# ─── WhatsApp deep-link integration (free, no API, no card) ─────────────────
# Merchant's WhatsApp number in international E.164 format WITHOUT the
# leading "+" and without spaces/dashes. Pakistan example: 923001234567
# (92 = country code, 3001234567 = 10-digit mobile). Storefront and admin
# render "Chat on WhatsApp" buttons that open wa.me/<number> with a pre-
# typed message; the merchant replies from the standard WhatsApp Business
# app on their phone. See `src/lib/whatsapp.ts` for the helper.
NEXT_PUBLIC_WHATSAPP_NUMBER=
