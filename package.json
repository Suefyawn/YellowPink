{
  "name": "yellowpink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:workers": "vinext dev --port 3000",
    "prebuild": "node -e \"require('fs').mkdirSync('public/docs',{recursive:true});require('fs').copyFileSync('docs/USER-MANUAL.md','public/docs/USER-MANUAL.md')\"",
    "build": "vinext build",
    "build:next": "next build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:production": "vinext-cloudflare deploy --env production --name yellowpink-production --config dist/server/wrangler.json",
    "deploy:scheduler": "wrangler deploy -c workers/scheduler/wrangler.jsonc",
    "deploy:scheduler:production": "wrangler deploy -c workers/scheduler/wrangler.jsonc --env production",
    "build:analyze": "ANALYZE=true next build --no-turbopack",
    "analyze": "next experimental-analyze",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "seo:parity": "tsx scripts/seo-parity.ts",
    "seo:snapshot": "tsx scripts/seo-snapshot.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@sentry/cloudflare": "10.75.0",
    "@sentry/core": "10.75.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "aws4fetch": "^1.0.20",
    "marked": "^15.0.12",
    "next": "16.2.4",
    "posthog-js": "^1.374.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "resend": "^6.12.3",
    "sharp": "^0.34.5",
    "vinext": "1.0.0-beta.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/vite-plugin": "1.56.0",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.48.2",
    "@types/node": "22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "patch-package": "8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
